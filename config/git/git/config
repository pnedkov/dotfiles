[user]
	useConfigOnly = true
[include]
	path = ../git-private/personal.conf
[alias]
	a = add
	aa = add --all
	ai = add -i
	ap = add --patch
	au = add --update
	an = add -N

	ay = apply
	ays = apply --stat
	ayc = apply --check

	b = branch
	ba = branch -a
	bd = branch -d
	br = branch -r

	c = commit
	ca = commit -a
	ci = commit -i
	cf = "!f() { \
		[ \"$#\" -eq 1 ] || { echo 'Usage: git cf <file>' >&2; return 1; }; \
		cd \"./${GIT_PREFIX}\" || return; \
		editor=$(git var GIT_EDITOR) || return; \
		case \"$1\" in /*) file=$1 ;; *) file=./$1 ;; esac; \
		sh -c \"$editor \\\"\\$@\\\"\" - \"$file\" && git ci -- \"$file\"; \
	}; f"
	cp = commit -p
	cm = commit -m
	cam = commit -am
	cd = commit --amend
	cad = commit -a --amend

	d = diff
	ds = diff --staged
	dt = difftool
	dlc = difftool --cached
	dk = diff --check
	dp = diff --patience
	dck = diff --cached --check

	f = fetch
	fo = fetch origin
	fu = fetch upstream

	g = grep -p

	l = log -10 --oneline --graph --decorate
	lo = -c core.pager='bat -n -l \"Git log\"' log --no-color --no-decorate
	lg = log -10 -m --graph --abbrev-commit --decorate --date=relative \
		--pretty=tformat:'%C(bold blue)%h%C(reset)%C(auto)%d -%C(reset) %C(auto)%s%C(reset) %C(white)[a:%an] [c:%cn]%C(reset) %C(green)(%ar)%C(reset)'
	lp = log -m --graph --follow -p

	ls = ls-files
	lsf = "!git ls-files | grep -i --"

	m = merge
	ma = merge --abort
	mc = merge --continue

	o = checkout
	ob = checkout -b
	oc = checkout .
	op = checkout -p

	ps = push
	psf = push --force-with-lease
	psa = push --all

	pl = pull
	plo = pull origin
	plom = "!f() { \
		mbranch=$(git symbolic-ref --quiet refs/remotes/origin/HEAD) || { echo 'Missing origin/HEAD. Run: git remote set-head origin -a' >&2; return 1; }; \
		mbranch=${mbranch#refs/remotes/origin/}; \
		git pull --rebase origin \"$mbranch:$mbranch\" \"$@\"; \
	}; f"
	plum = "!f() { \
		mbranch=$(git symbolic-ref --quiet refs/remotes/upstream/HEAD) || { echo 'Missing upstream/HEAD. Run: git remote set-head upstream -a' >&2; return 1; }; \
		mbranch=${mbranch#refs/remotes/upstream/}; \
		git pull --rebase upstream \"$mbranch:$mbranch\" \"$@\"; \
	}; f"

	rb = rebase
	rba = rebase --abort
	rbc = rebase --continue
	rbi = rebase --interactive
	rbs = rebase --skip
	rbh = "!f() { \
		count=${1-1}; \
		case \"$count\" in ''|*[!0-9]*) echo 'Commit count must be a non-negative integer.' >&2; return 1 ;; esac; \
		[ \"$#\" -eq 0 ] || shift; \
		git rebase -i \"HEAD~$count\" \"$@\"; \
	}; f"

	re = reset
	reh = reset --hard
	res = reset --soft

	r = remote
	ra = remote add
	rr = remote rm
	rv = remote -v
	#rm = remote rename
	rp = remote prune
	rs = remote show
	rao = remote add origin
	rau = remote add upstream
	rso = remote show origin
	rsu = remote show upstream
	rpo = remote prune origin
	rpu = remote prune upstream

	s = status -s
	sb = status -s -b

	sa = stash apply
	sc = stash clear
	sd = stash drop
	sl = stash list
	sp = stash pop
	ss = stash push
	sw = stash show

	tags = tag -n99

	w = show --color -m
	wn = show --name-only --color -m
	ws = show --color -C --stat

	whatis = show -s --pretty='tformat:%h (%s, %ad)' --date=short

[diff]
	tool = vimdiff
[difftool]
	prompt = false
[core]
	pager = delta
	whitespace = -indent-with-non-tab,trailing-space,cr-at-eol
[interactive]
	diffFilter = delta --color-only
[delta]
	dark = true
	navigate = true
	side-by-side = true
[merge]
	conflictStyle = zdiff3
[credential]
	helper = cache --timeout=2419200
[rerere]
	enabled = true
	autoupdate = true
[diff "ansible-vault"]
	textconv = ansible-vault view
	#cachetextconv = true
[rebase]
	autoStash = true
[branch]
	autosetuprebase = always
[pull]
	rebase = true
[fetch]
	prune = true
[push]
	autoSetupRemote = true
